# Copy to .env to override the backend URL the UI talks to.
VITE_API_BASE=http://localhost:4000

# API key sent on protected calls (batch create/register, on-chain verify, tamper).
# Must match one of the backend's API_KEYS. Leave empty in local dev.
VITE_API_KEY=

# --- Field Verify trust anchors (security-critical) --------------------------
# A scanned QR is attacker-controlled. The verifier must read the batch root from
# the chain, at a contract IT trusts. Never take the RPC or contract from the QR.
#
# Chain RPC. Set this to verify TRUSTLESSLY (browser reads the chain directly).
# Leave empty to fall back to the backend's /batch/:id/onchain route (which puts
# the backend in the trust path).
VITE_RPC_URL=http://127.0.0.1:7545

# The registry address the verifier trusts. Leave empty to use the address the
# backend reports (dev convenience). In production, pin this.
VITE_CONTRACT_ADDRESS=
