# Copy to .env and adjust to match your environment.

# Port the Express API listens on.
PORT=4000

# Ganache JSON-RPC endpoint.
#   Ganache GUI  -> http://127.0.0.1:7545
#   Ganache CLI  -> http://127.0.0.1:8545
GANACHE_RPC_URL=http://127.0.0.1:7545

# Deployed ProductRegistry address.
# Leave blank to auto-detect from build/contracts/ProductRegistry.json
# (Truffle records the address per network after `truffle migrate`).
CONTRACT_ADDRESS=

# Index of the Ganache account used to send transactions (the manufacturer).
# Must match the account that deployed the contract (owner of registerBatch).
MANUFACTURER_ACCOUNT_INDEX=0

# Storage driver: "json" (default, file-backed) or "sqlite" (embedded node:sqlite).
STORE_DRIVER=json
# JSON driver: where to persist batches (relative to backend/).
DATA_FILE=./data/batches.json
# SQLite driver: database file path (":memory:" for ephemeral). Defaults to
# DATA_FILE with a .sqlite extension when unset.
SQLITE_PATH=

# Log level for structured (pino) logs: trace|debug|info|warn|error|silent.
LOG_LEVEL=info

# Comma-separated API keys for protected (mutating / gas-spending) endpoints:
#   POST /batch/create, /batch/register, /verify, /verify/tamper
# Leave EMPTY for local dev (endpoints unprotected — a warning is logged).
# In production, set one or more strong random keys.
API_KEYS=
